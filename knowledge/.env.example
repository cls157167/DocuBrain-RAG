
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=your_api_key_here
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=your-base-here
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数
LLM_DEFAULT_TEMPERATURE=0.1

# VLM视觉语言模型
VL_MODEL=qwen3-vl-flash
# 商品名识别相关模型
ITEM_MODEL=qwen-flash
# 知识图谱模型
KG_MODEL=qwen-flash

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\$AAA\0.software\0、Large Models\models\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备 cuda:0
BGE_DEVICE=cpu
# 是否使用半精度
BGE_FP16=False
# BGE 重排序模型路径
BGE_RERANKER_LARGE=D:\$AAA\0.software\0、Large Models\models\bge-reranker-v2-m3
# 重排序模型设备 cuda:0
BGE_RERANKER_DEVICE=cpu
# 重排序模型半精度
BGE_RERANKER_FP16=1
# 项目名称诊断标志
ITEM_NAME_DIAG=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://218.244.155.46:19530
# 知识库集合名
# CHUNKS_COLLECTION=kb_chunks_v1
CHUNKS_COLLECTION=kb_chunks_v2
ITEM_COLLECTION_NAME=item_collection
CHUNK_COLLECTION_NAME=chunk_collection

# 实体名称集合名
# ENTITY_NAME_COLLECTION=kb_graph_entity_names_v1
ENTITY_NAME_COLLECTION=kb_graph_entity_names_v2


# 商品名称集合名
# ITEM_NAME_COLLECTION=kb_item_names_v1
ITEM_NAME_COLLECTION=kb_item_names_v2
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# 对齐阈值
# 高置信阈值
HIGH_CONFIDENCE_THRESHOLD=0.7
# 中置信阈值
MID_CONFIDENCE_THRESHOLD=0.6
# 最大候选数
MAX_OPTIONS=5

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://218.244.155.46:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=218.244.155.46:9000
# 访问密钥
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base-v2

# ====================
# Other / MCP Services
